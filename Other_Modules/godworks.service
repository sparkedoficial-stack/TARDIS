[Unit]
Description=GODWORKS SYSTEM v26.4 - GIA Sovereign Temporal Control Service
Documentation=https://github.com/
After=network.target network-online.target systemd-networkd.service
Wants=network-online.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%WORKDIR%
ExecStart=%WORKDIR%/.venv-linux/bin/python3 %WORKDIR%/supervisor.py
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=15s

# Cargar variables de entorno protegidas desde .env
EnvironmentFile=%WORKDIR%/.env
Environment=PYTHONUNBUFFERED=1
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=GIA_PORT=8757
Environment=GIA_HOST=127.0.0.1
Environment=PATH=%WORKDIR%/.venv-linux/bin:/home/%USER%/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Límites de descriptores para mmap y sockets de alta concurrencia
LimitNOFILE=65535
LimitNPROC=32768
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
