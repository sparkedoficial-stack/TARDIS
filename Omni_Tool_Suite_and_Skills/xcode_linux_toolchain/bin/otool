#!/usr/bin/env python3
"""
otool - Object file displaying tool for Linux
Compatible with Apple's macOS otool CLI syntax via llvm-objdump.
Part of Xcode for Linux (xcode-linux).
"""

import sys
import subprocess

def main():
    args = sys.argv[1:]
    if not args or "-h" in args and len(args) == 1:
        # Help or mach header? In otool -h prints mach header.
        pass

    llvm_args = ["/usr/bin/llvm-objdump", "--macho"]
    
    translate = {
        "-L": "--dylibs-used",
        "-l": "--private-headers",
        "-h": "--private-header",
        "-t": "-d",
        "-tv": "-d",
        "-tV": "-d",
        "-D": "--dylib-id",
        "-o": "--objc-meta-data",
        "-ov": "--objc-meta-data",
        "-s": "-j",
    }
    
    files = []
    for a in args:
        if a in translate:
            llvm_args.append(translate[a])
        elif a.startswith("-"):
            llvm_args.append(a)
        else:
            files.append(a)
            
    if not any(a.startswith("-") for a in llvm_args[2:]):
        llvm_args.append("--private-header")
        
    cmd = llvm_args + files
    sys.exit(subprocess.call(cmd))

if __name__ == "__main__":
    main()
