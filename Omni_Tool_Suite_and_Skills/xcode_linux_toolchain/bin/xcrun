#!/usr/bin/env python3
"""
xcrun - Run or locate development tools and properties on Linux
Compatible with Apple's macOS xcrun CLI syntax.
Part of Xcode for Linux (xcode-linux).
"""

import sys
import os
import subprocess
import shutil

XCODE_BIN = "/opt/xcode-linux/bin"

def main():
    args = sys.argv[1:]
    if not args:
        print("Usage: xcrun [-sdk <sdk_name>] <tool_name> [tool_arguments...]")
        sys.exit(1)

    # Filter SDK flags
    sdk = "iphoneos"
    cleaned_args = []
    skip = False
    for i, a in enumerate(args):
        if skip:
            skip = False
            continue
        if a in ("-sdk", "--sdk"):
            skip = True
            sdk = args[i+1] if i + 1 < len(args) else "iphoneos"
            continue
        if a.startswith("-find") or a.startswith("--find"):
            tool_name = args[i+1] if i + 1 < len(args) else None
            if tool_name:
                p = shutil.which(tool_name, path=f"{XCODE_BIN}:{os.environ.get('PATH', '')}")
                if p:
                    print(p)
                    return
                print(f"xcrun: error: cannot find tool '{tool_name}'", file=sys.stderr)
                sys.exit(1)
            return
        cleaned_args.append(a)

    if not cleaned_args:
        sys.exit(0)

    tool = cleaned_args[0]
    tool_args = cleaned_args[1:]

    # Map tools
    custom_tools = {
        "plutil": os.path.join(XCODE_BIN, "plutil"),
        "codesign": os.path.join(XCODE_BIN, "codesign"),
        "otool": os.path.join(XCODE_BIN, "otool"),
        "lipo": os.path.join(XCODE_BIN, "lipo"),
        "xcodebuild": os.path.join(XCODE_BIN, "xcodebuild"),
        "devicectl": os.path.join(XCODE_BIN, "xcode-linux"),
    }

    if tool in custom_tools:
        exec_path = custom_tools[tool]
        sys.exit(subprocess.call([exec_path] + tool_args))

    # Look up in XCODE_BIN then system PATH
    tool_path = shutil.which(tool, path=f"{XCODE_BIN}:{os.environ.get('PATH', '')}")
    if tool_path:
        sys.exit(subprocess.call([tool_path] + tool_args))
    else:
        print(f"xcrun: error: unable to find tool '{tool}' on Linux", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
