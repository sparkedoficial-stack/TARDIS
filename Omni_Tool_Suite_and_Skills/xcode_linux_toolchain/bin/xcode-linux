#!/usr/bin/env python3
"""
==============================================================================
   XCODE FOR LINUX (xcode-linux)
   Entorno Soberano de Desarrollo, Firma, Análisis REA y Despliegue para Apple iOS
   Author: Antigravity OS / GODWORKS System
==============================================================================
"""

import sys
import os
import argparse
import subprocess
import shutil

# Ensure local lib directory is in sys.path
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
LIB_DIR = os.path.join(os.path.dirname(SCRIPT_DIR), "lib")
if LIB_DIR not in sys.path:
    sys.path.insert(0, LIB_DIR)

from device_manager import get_connected_devices, list_installed_apps, install_app, push_to_media, stream_syslog
from macho_engine import parse_macho, print_macho_summary
from rea_bridge import inspect_ipa_with_rea, print_ipa_report
from builder import build_app

def cmd_info(args):
    print("==========================================================")
    print("             XCODE PARA LINUX - ESTADO DEL SISTEMA        ")
    print("==========================================================")
    tools = [
        ("Clang (ARM64/Darwin)", shutil.which("clang")),
        ("LLD Linker", shutil.which("lld")),
        ("LLVM Objdump (Mach-O)", shutil.which("llvm-objdump")),
        ("LLVM Lipo", shutil.which("llvm-lipo")),
        ("Property List Util (plutil)", shutil.which("plistutil") or "/opt/xcode-linux/bin/plutil"),
        ("Signer Engine (zsign)", "/home/timemachine/melonx_install/zsign"),
        ("Apple File Conduit (AFC)", "/home/timemachine/.local/bin/pymobiledevice3"),
        ("USB Multiplexor (usbmuxd)", shutil.which("usbmuxd")),
        ("Device Installer", shutil.which("ideviceinstaller")),
    ]
    for name, path in tools:
        status = "✓ DISPONIBLE" if path and (os.path.isfile(path) or shutil.which(path)) else "✗ NO ENCONTRADO"
        print(f" {name:<28}: {status} ({path})")
    
    devs = get_connected_devices()
    print("----------------------------------------------------------")
    print(f" Dispositivos iOS Conectados: {len(devs)}")
    for d in devs:
        dev_mode = "Activo ✓" if d["developer_mode"] else "Inactivo ✗"
        print(f"  * {d['name']} [{d['model']}] (iOS {d['version']}) | UDID: {d['udid']} | DevMode: {dev_mode}")
    print("==========================================================")

def cmd_devices(args):
    devs = get_connected_devices()
    if not devs:
        print("[!] No se detectaron dispositivos iOS conectados vía USB o Wi-Fi.")
        return
    print(f"\n[✓] Dispositivos iOS detectados ({len(devs)}):")
    for i, d in enumerate(devs, 1):
        print(f"\n [{i}] {d['name']}")
        print(f"     Modelo:           {d['model']} ({d['class']})")
        print(f"     Versión de iOS:   {d['version']} (Build {d['build']})")
        print(f"     UDID:             {d['udid']}")
        print(f"     Conexión:         {d['connection']}")
        print(f"     Modo Desarrollador:{'ACTIVO ✓' if d['developer_mode'] else 'INACTIVO ✗'}")

def cmd_apps(args):
    print(f"[*] Consultando aplicaciones instaladas...")
    apps = list_installed_apps(args.udid)
    print(f"\n[✓] Total de aplicaciones de usuario: {len(apps)}\n")
    for a in apps:
        print(f"  * {a['name']:<25} v{a['version']:<12} ({a['bundle_id']})")

def cmd_inspect(args):
    target = args.path
    if not os.path.exists(target):
        print(f"[!] Error: El archivo {target} no existe.")
        sys.exit(1)

    if target.endswith(".ipa") or target.endswith(".zip"):
        print(f"[*] Analizando paquete iOS mediante REA: {target}...")
        report = inspect_ipa_with_rea(target)
        print_ipa_report(report)
    else:
        print(f"[*] Analizando binario Mach-O: {target}...")
        m_info = parse_macho(target)
        print_macho_summary(m_info)

def cmd_install(args):
    target = args.ipa
    print(f"[*] Desplegando {target} en el dispositivo iOS...")
    ok, msg = install_app(target, args.udid)
    if ok:
        print(f"[✓] Éxito: {msg}")
    else:
        print(f"[!] Falló la instalación:\n{msg}")

def cmd_push(args):
    src = args.file
    dest = args.dest or "/Downloads/"
    print(f"[*] Transfiriendo {src} al dispositivo en {dest}...")
    ok, msg = push_to_media(src, dest)
    if ok:
        print(f"[✓] {msg}")
    else:
        print(f"[!] Error: {msg}")

def cmd_console(args):
    print("[*] Iniciando consola de logs de iOS en tiempo real (Ctrl+C para salir)...")
    stream_syslog(args.udid)

def cmd_build(args):
    print(f"[*] Compilando y empaquetando proyecto: {args.project}...")
    ok, res = build_app(
        args.project,
        output_dir=args.output,
        app_name=args.name,
        bundle_id=args.bundle_id,
        sign=args.sign,
        mobileprovision=args.mobileprovision
    )
    if ok:
        print(f"[✓] Compilación finalizada exitosamente: {res}")
    else:
        print(f"[!] Error en la compilación: {res}")

def main():
    parser = argparse.ArgumentParser(
        prog="xcode-linux",
        description="Xcode para Linux: Entorno de Desarrollo, Análisis REA y Despliegue para iOS"
    )
    subparsers = parser.add_subparsers(dest="command")

    # info
    subparsers.add_parser("info", help="Estado del toolchain y entorno de Xcode")
    
    # devices
    subparsers.add_parser("devices", help="Listar dispositivos iOS conectados (Organizador)")

    # apps
    p_apps = subparsers.add_parser("apps", help="Listar aplicaciones en el dispositivo")
    p_apps.add_argument("-u", "--udid", help="UDID del dispositivo objetivo")

    # inspect
    p_insp = subparsers.add_parser("inspect", help="Análisis profundo REA de IPA o Mach-O")
    p_insp.add_argument("path", help="Ruta al archivo .ipa, .app o binario Mach-O")

    # install
    p_inst = subparsers.add_parser("install", help="Instalar paquete IPA en el dispositivo")
    p_inst.add_argument("ipa", help="Ruta al archivo .ipa a instalar")
    p_inst.add_argument("-u", "--udid", help="UDID del dispositivo objetivo")

    # push
    p_push = subparsers.add_parser("push", help="Transferir archivo a la memoria del iPad/iPhone")
    p_push.add_argument("file", help="Archivo local")
    p_push.add_argument("-d", "--dest", default="/Downloads/", help="Ruta de destino en /var/mobile/Media")

    # console
    p_cons = subparsers.add_parser("console", help="Stream en vivo de la consola de logs del dispositivo")
    p_cons.add_argument("-u", "--udid", help="UDID del dispositivo objetivo")

    # build
    p_bld = subparsers.add_parser("build", help="Compilar y empaquetar una aplicación iOS")
    p_bld.add_argument("project", help="Directorio del proyecto fuente")
    p_bld.add_argument("-o", "--output", help="Directorio de salida para el build")
    p_bld.add_argument("-n", "--name", help="Nombre de la aplicación")
    p_bld.add_argument("-b", "--bundle-id", help="Bundle Identifier")
    p_bld.add_argument("-s", "--sign", action="store_true", help="Firmar la aplicación tras compilar")
    p_bld.add_argument("-m", "--mobileprovision", help="Perfil de aprovisionamiento")

    args = parser.parse_args()

    if not args.command or args.command == "info":
        cmd_info(args)
    elif args.command == "devices":
        cmd_devices(args)
    elif args.command == "apps":
        cmd_apps(args)
    elif args.command == "inspect":
        cmd_inspect(args)
    elif args.command == "install":
        cmd_install(args)
    elif args.command == "push":
        cmd_push(args)
    elif args.command == "console":
        cmd_console(args)
    elif args.command == "build":
        cmd_build(args)

if __name__ == "__main__":
    main()
